{
    "name": "hand-bluetooth",
    "description": "uHandbit: move the hand from commands sent over Bluetooth (from the ESP32 remote)",
    "dependencies": {
        "core": "*",
        "bluetooth": "*",
        "StartbitV2": "github:Hiwonder/StartbitV2"
    },
    "files": [
        "main.ts",
        "README.md"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj",
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    }
}
